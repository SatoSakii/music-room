// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REFUSED
}

enum VoteValue {
  UP
  DOWN
}

enum VoteLicense {
  EVERYONE
  INVITED_ONLY
  LOCATION_TIME
}

enum PlaylistEditLicense {
  EVERYONE
  INVITED_ONLY
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum Platform {
  IOS
  ANDROID
  WEB
  OTHER
}

enum MusicProvider {
  DEEZER
  SPOTIFY
  YOUTUBE
  LOCAL
}

enum MusicType {
  POP
  ROCK
  METAL
  PUNK
  INDIE
  ALTERNATIVE
  HIP_HOP
  RAP
  RNB
  SOUL
  FUNK
  DISCO
  JAZZ
  BLUES
  CLASSICAL
  OPERA
  ELECTRONIC
  HOUSE
  TECHNO
  TRANCE
  DRUM_AND_BASS
  DUBSTEP
  AMBIENT
  LOFI
  REGGAE
  DANCEHALL
  AFROBEATS
  LATIN
  REGGAETON
  SALSA
  COUNTRY
  FOLK
  WORLD
  KPOP
  JPOP
  SOUNDTRACK
  GOSPEL
  OTHER
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String?

  emailVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subscribed Boolean @default(false)

  data          UserData?
  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  devices       Device[]
  actionLogs    ActionLog[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  ownedEvents     Event[]      @relation("EventOwners")
  attendedEvents  Event[]      @relation("EventParticipants")
  addedEventMusic EventMusic[]
  votes           Vote[]

  ownedPlaylists       Playlist[]      @relation("PlaylistOwner")
  collaboratedPlaylist Playlist[]      @relation("PlaylistCollaboration")
  likedPlaylists       Playlist[]      @relation("PlaylistLikes")
  addedPlaylistTracks  PlaylistTrack[]

  invitations         Invitation[] @relation("InvitationTarget")
  sentInvitations     Invitation[] @relation("InvitationSender")
  grantedDelegations  Delegation[] @relation("DelegationOwner")
  receivedDelegations Delegation[] @relation("DelegationDelegate")

  @@index([deletedAt])
}

model OAuthAccount {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, userId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String    @id @default(uuid())
  type      TokenType
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Device {
  id        String   @id @default(uuid())
  name      String
  platform  Platform
  osVersion String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  delegationEnabled Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]
  delegations   Delegation[]

  @@index([userId])
}

model Delegation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("DelegationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  delegateId String
  delegate   User   @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Cascade)

  @@unique([deviceId, delegateId])
  @@index([delegateId])
}

model ActionLog {
  id         String   @id @default(uuid())
  action     String
  platform   Platform
  device     String
  appVersion String
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserData {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailVisibility Visibility @default(PUBLIC)
  pfpUrl          String?
  pfpVisibility   Visibility @default(PUBLIC)

  firstName           String?
  firstNameVisibility Visibility @default(PUBLIC)

  lastName           String?
  lastNameVisibility Visibility @default(FRIENDS)

  dateOfBirth           DateTime?
  dateOfBirthVisibility Visibility @default(PRIVATE)

  city           String?
  cityVisibility Visibility @default(FRIENDS)

  musicPreference           MusicType[]
  musicPreferenceVisibility Visibility  @default(FRIENDS)
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Music {
  id     String @id @default(uuid())
  title  String
  author String

  provider        MusicProvider
  providerTrackId String
  durationSec     Int?
  coverUrl        String?
  genre           MusicType?

  plays  EventMusic[]
  tracks PlaylistTrack[]

  @@unique([provider, providerTrackId])
  @@index([title])
}

model Playlist {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isPublic    Boolean             @default(true)
  editLicense PlaylistEditLicense @default(EVERYONE)

  creatorId String
  creator   User   @relation("PlaylistOwner", fields: [creatorId], references: [id])

  collaborators User[] @relation("PlaylistCollaboration")
  likedBy       User[] @relation("PlaylistLikes")

  invitations Invitation[]
  tracks      PlaylistTrack[]

  @@index([creatorId])
  @@index([isPublic])
}

model PlaylistTrack {
  id String @id @default(uuid())

  position Float

  version Int @default(0)

  addedAt DateTime @default(now())

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  musicId String
  music   Music  @relation(fields: [musicId], references: [id], onDelete: Cascade)

  addedById String
  addedBy   User   @relation(fields: [addedById], references: [id])

  @@unique([playlistId, musicId])
  @@index([playlistId, position])
  @@index([addedById])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  pfpUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isPublic Boolean @default(true)

  voteLicense VoteLicense @default(EVERYONE)

  latitude     Float?
  longitude    Float?
  radiusMeters Int?

  voteWindowStart DateTime?
  voteWindowEnd   DateTime?

  owners       User[] @relation("EventOwners")
  participants User[] @relation("EventParticipants")

  queue       EventMusic[]
  invitations Invitation[]

  @@index([isPublic])
  @@index([createdAt])
}

model EventMusic {
  id String @id @default(uuid())

  addedAt  DateTime  @default(now())
  playedAt DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  musicId String
  music   Music  @relation(fields: [musicId], references: [id], onDelete: Cascade)

  addedById String
  addedBy   User   @relation(fields: [addedById], references: [id])

  votes Vote[]

  @@unique([eventId, musicId])
  @@index([eventId, playedAt])
}

model Vote {
  id        String    @id @default(uuid())
  value     VoteValue
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventMusicId String
  eventMusic   EventMusic @relation(fields: [eventMusicId], references: [id], onDelete: Cascade)

  @@unique([userId, eventMusicId])
  @@index([eventMusicId])
}

model Invitation {
  id String @id @default(uuid())

  status          InvitationStatus @default(PENDING)
  statusChangedAt DateTime         @default(now())
  createdAt       DateTime         @default(now())

  targetId String
  target   User   @relation("InvitationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation("InvitationSender", fields: [senderId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([targetId, eventId])
  @@unique([targetId, playlistId])
  @@index([targetId, status])
}
